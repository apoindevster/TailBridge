[Unit]
Description=ts-redir management on the Tailscale interface
Wants=tailscaled.service
Requires=tailbridge-firewall.service
After=tailscaled.service tailbridge-firewall.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
StateDirectory=tailbridge-redir
StateDirectoryMode=0700
Environment=TAILBRIDGE_RULES_FILE=/var/lib/tailbridge-redir/rules.json
ExecStart=/opt/tailbridge/bin/ts-redir --web --ts-interface tailscale0 --port 8800
Restart=always
RestartSec=10
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
